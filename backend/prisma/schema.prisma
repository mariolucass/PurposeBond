generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                 String @id @default(uuid())
  username           String @db.VarChar(50) @unique
  name               String @db.VarChar(100)
  email              String @db.VarChar(100) @unique
  password           String @db.VarChar(128)

  profileImage       String?   @db.VarChar(500) 
  address            String? @db.VarChar(100)
  phone              String? @db.VarChar(15)
  birthDate          DateTime? 
  description        String? @db.Text()
  joinedAt           DateTime @default(now())

  settings           Settings[] 

  posts              Post[]
  postViews          PostView[] 

  comments           Comment[]
  likes              Like[]

  followers Follow[] @relation("following")
  following Follow[] @relation("followers")

  messagesSent       Message[] @relation("Sent")
  messagesReceived   Message[] @relation("Received")

  reposts            Repost[] 

  notificationsSent  Notification[] @relation(name: "notificationNotifier")
  notifications      Notification[]

  ownedCommunities  Community[]
  communityMemberships CommunityMember[]

  badges     UserBadge[]

  activityLogs UserActivityLog[]

  mentions           Mention[]

  @@map("users")
}

model Follow {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  
  follower   User     @relation("followers", fields: [followerId], references: [id])
  followerId String

  following  User     @relation("following", fields: [followingId], references: [id])
  followingId String

  @@unique([followerId, followingId])
  @@map("follows")
}

model Settings {
  id                 String  @id @default(uuid())

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String  @unique

  emailNotifications Boolean   @default(true) 
  privateProfile     Boolean   @default(false) 
  language           String    @default("en") 

  contentFilters     String[]
  darkMode           Boolean   @default(false) 

  twoFactorAuth      Boolean   @default(false)

  @@map("settings") 
}

model Post {
  id         String @id @default(uuid())
  content    String @db.Text()
  createdAt  DateTime @default(now())
 
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  media      Media[]  
  
  likes      Like[]
  reposts    Repost[] 
  comments   Comment[]

  mentions   Mention[]

  views      PostView[]

  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  communityId String?

  @@map("posts")
}

model Mention {
  id         String @id @default(uuid())

  user       User   @relation(fields: [userId], references: [id])
  userId     String

  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String

  @@map("mentions")
}

enum MediaType { 
  IMAGE
  VIDEO
}
model Media {  
  id         String    @id @default(uuid())
  url        String    @db.VarChar(254) 
  type       MediaType 

  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String

  @@map("media")
}

model PostView {
  id         String   @id @default(uuid())
  viewedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String

  @@unique([userId, postId])
  @@map("postviews")
}

model Repost {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String 

  @@map("reposts")
}

model Comment {
  id         String @id @default(uuid())
  content    String @db.Text()
  createdAt  DateTime @default(now())

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String

  @@map("comments")
}

model Like {
  id         String @id @default(uuid())
  createdAt  DateTime @default(now())

  author     User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
 
  @@map("likes")
}

model Message {
  id         String @id @default(uuid())
  content    String @db.Text()
  createdAt  DateTime @default(now())

  sender     User?     @relation("Sent", fields: [senderId], references: [id], onDelete: SetNull)
  senderId   String?

  receiver   User?    @relation("Received", fields: [receiverId], references: [id], onDelete: SetNull)
  receiverId String? 
  
  @@map("messages")
}

enum NotificationType {
  NEW_FOLLOWER
  PROFILE_MENTIONED

  POST_CREATED
  POST_LIKED
  POST_COMMENTED
  POST_REPOSTED
  POST_MENTIONED

  COMMENT_LIKED
  COMMENT_MENTIONED

  COMMUNITY_INVITE
  COMMUNITY_JOINED
  COMMUNITY_ROLE_UPDATED

  NEW_MESSAGE

  BADGE_GRANTED

  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

enum NotificationTargetType {
  POST
  COMMENT
  LIKE
  REPOST
  USER
  COMMUNITY
  MESSAGE
  BADGE
}


model Notification {
  id          String         @id @default(uuid())

  type        NotificationType
  targetType   NotificationTargetType
  targetId String

  createdAt   DateTime       @default(now())
  isRead      Boolean        @default(false)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  author      User           @relation(name: "notificationNotifier", fields: [authorId], references: [id], onDelete: Cascade)  
  authorId    String 

  @@map("notifications")
}

enum BadgeType {
  VERIFICATION
  COMMUNITY
  CONTRIBUTION
}

model Badge {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String  
  type      BadgeType
  createdAt DateTime @default(now())

  users     UserBadge[]
}

model UserBadge {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId  String

  grantedAt DateTime @default(now())

  @@id([userId, badgeId])
}

enum ActivityType {
  POST_CREATED
  POST_LIKED
  FOLLOWED_USER
  COMMENTED
  JOINED_COMMUNITY
}

enum ActivityTargetType {
  POST
  COMMUNITY
  USER
}

model UserActivityLog {
  id        String   @id @default(uuid())
  type      ActivityType
  targetType ActivityTargetType?
  referenceId String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.Text()
  image       String?
  createdAt   DateTime @default(now())

  owner       User     @relation(fields: [ownerId], references: [id])
  ownerId     String

  members     CommunityMember[]
  posts       Post[] 
}


model CommunityMember {
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String

  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId  String 
  joinedAt     DateTime @default(now())

  @@id([userId, communityId])
}


